__pycache__/
*.py[cod]
*$py.class

# C extensions for Python
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
