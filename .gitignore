lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python logs
*.log
*.out
*.err

# Python type checker (Pyre, MyPy)
.pyre/
.mypy_cache/

# Pytest cache
.pytest_cache/

# PyInstaller files (used to bundle Python apps)
*.manifest
*.spec

# Cython debug symbols
cython_debug/

# Environment variables
.env
.env.*

# Python virtual environment generated files
pip-log.txt
pip-delete-this-directory.txt

# R renv library folder (project-specific package environment)
renv/library/

# RStudio project files
.Rproj.user/
*.Rproj

# R Markdown cached files and figures
.Rhistory
.RData
.Ruserdata
*.utf8.md
*.knit.md

# R Markdown outputs (optional - only if you don't want to track outputs)
*.html
*.pdf
*.docx
*.rds

# R packages specific caches and logs
.Renviron
.Rprofile
.vsc_r_log/

# RStudio configuration
.rsconnect/

# Packrat (R's older package management tool, usually replaced by renv)
packrat/

# VS Code settings
.vscode/

# General IDE-specific files (VSCode, PyCharm, RStudio, etc.)
.idea/
*.iml

